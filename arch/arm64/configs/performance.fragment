# ---------------------------------------------------------------------------
# performance.fragment - Infinix Hot 50 4G (X6882 / MT6789)
# Base: pristine AOSP ACK android12-5.10-lts, pinned by the CI workflow.
#
# Merge with:
#   scripts/kconfig/merge_config.sh -m -O out out/.config \
#       arch/arm64/configs/performance.fragment
#   make O=out ... olddefconfig
#
# RULE: only settings that cannot change a genksyms CRC belong in this file.
#
# The 186 vendor modules were built against the frozen GKI KMI recorded in
# android/abi_gki_aarch64.xml. genksyms hashes every type reachable from an
# exported symbol, so any option that adds/removes a struct member silently
# changes the ABI. Measured examples on this tree:
#
#   gki_defconfig                     __alloc_pages_nodemask = 0xcfd14bde  (vendor)
#   CONFIG_TRANSPARENT_HUGEPAGE=n     __alloc_pages_nodemask = 0x0407c052  (broken)
#
# A single wrong CRC costs the module a force-load taint at best and gives it
# a different struct layout at worst. Type-affecting options are therefore
# left at the gki_defconfig value and asserted in the workflow instead:
#   KASAN=y, KASAN_HW_TAGS=y, TRANSPARENT_HUGEPAGE=y,
#   TRANSPARENT_HUGEPAGE_MADVISE=y, MODVERSIONS=y, MODULE_SCMVERSION=y.
# ---------------------------------------------------------------------------

# --- Branding (no ABI effect) ----------------------------------------------
# BRANCH/KMI_GENERATION are not exported by this workflow, so the whole
# "-android12-9-<name>" suffix comes from CONFIG_LOCALVERSION.
CONFIG_LOCALVERSION="-android12-9-Satetsu-Shigure"

# --- Link time optimisation ------------------------------------------------
# ThinLTO is required by the project spec. gki_defconfig selects FULL; both
# define CONFIG_LTO_CLANG=y, so no type is gated on the choice.
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set

# --- Scheduler / timer -----------------------------------------------------
CONFIG_HZ_300=y
CONFIG_PREEMPT=y

# --- Networking ------------------------------------------------------------
CONFIG_NET_SCH_FQ=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
# DEFAULT_TCP_CONG is a string chosen by the DEFAULT_BBR choice entry, not by
# writing the string directly: olddefconfig would otherwise reset it to cubic.
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_TCP_CONG="bbr"

# --- Crypto ----------------------------------------------------------------
CONFIG_CRYPTO_LZ4=y

# --- Module loading --------------------------------------------------------
# The build is expected to reproduce the vendor CRCs exactly, so FORCE_LOAD
# should never trigger. It is kept as a safety net so that a future sublevel
# bump degrades to warnings instead of an unbootable device.
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y

# --- ABI invariants (explicit, even where gki_defconfig already sets them) --
# Hugepages stay compiled in because struct page must match the modules. The
# madvise default means no background THP: only madvise(MADV_HUGEPAGE) users
# get hugepages, which is the effective "THP off" behaviour we want.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set

# KASAN_HW_TAGS is what the stock kernel uses; hw_tags.c is the only exporter
# of kasan_flag_enabled, which ten vendor modules import.
CONFIG_KASAN=y
CONFIG_KASAN_HW_TAGS=y

CONFIG_MODVERSIONS=y
CONFIG_MODULE_SCMVERSION=y
# MODULE_SCMVERSION has "depends on LOCALVERSION_AUTO", so AUTO must stay on
# even though the original spec asked for it off. The source tree has no .git
# (exact-commit tarball), so scripts/setlocalversion returns an empty string:
# the release stays clean and never gains -dirty or -g<sha>.
CONFIG_LOCALVERSION_AUTO=y
# CONFIG_TRIM_UNUSED_KSYMS is not set

# --- Build time ------------------------------------------------------------
# DWARF for a 40 MB Image costs ~20 minutes per run and is not used.
# CONFIG_DEBUG_INFO is not set
